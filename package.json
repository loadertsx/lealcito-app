{
	"name": "lealcito-app",
	"version": "0.0.2",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"typecheck": "wrangler types && react-router typegen && tsc -b",
		"deploy": "bun run build && wrangler deploy",
		"deploy:stg": "bun run build && wrangler deploy --env stg",
		"preview": "bun run build && vite preview",
		"cf-typegen": "wrangler types",
		"postinstall": "wrangler types",
		"cf:typegen": "wrangler types",
		"rr:typegen": "react-router typegen",
		"rr:routes": "react-router routes",
		"check:types": "tsc",
		"check:quality": "biome check .",
		"check:quality:fix": "biome check . --write --unsafe",
		"db:studio": "drizzle-kit studio --config drizzle.studio.local.config.ts",
		"db:studio:local": "bun run db:studio",
		"db:studio:stg": "drizzle-kit studio --config drizzle.studio.stg.config.ts",
		"db:new": "drizzle-kit generate",
		"db:new:custom": "drizzle-kit generate --custom",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:stg": "wrangler d1 migrations apply DB --env stg --remote",
		"db:migrate:prod": "wrangler d1 migrations apply DB --remote",
		"db:status:local": "wrangler d1 migrations list DB --local",
		"db:status:stg": "wrangler d1 migrations list DB --env stg --remote",
		"db:status:prod": "wrangler d1 migrations list DB --remote",
		"db:exec:local": "wrangler d1 execute DB --local"
	},
	"dependencies": {
		"dotenv": "^18.0.1",
		"drizzle-orm": "^1.0.0-rc.4",
		"isbot": "^5.1.36",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.1",
		"resend": "^6.28.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@cloudflare/vite-plugin": "^1.56.0",
		"@libsql/client": "^0.18.0",
		"@react-router/dev": "^8.3.1",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^26.6.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"drizzle-kit": "^1.0.0-rc.4",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"vite": "^8.0.3",
		"wrangler": "^4.135.0"
	}
}
